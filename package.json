{
  "name": "remy-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_MOCK_API=1 vite",
    "dev:https": "cross-env HTTPS=true vite",
    "dev:tunnel": "cross-env TUNNEL=1 concurrently -k -n vite,tunnel -c cyan,magenta \"vite\" \"cloudflared tunnel --url http://localhost:5173\"",
    "dev:ngrok": "cross-env TUNNEL=1 concurrently -k -n vite,ngrok -c cyan,magenta \"vite\" \"node scripts/ngrok.mjs\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:ngrok": "pnpm build && concurrently -k -n preview,ngrok -c cyan,magenta \"vite preview --port 5173 --strictPort\" \"node scripts/ngrok.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "contract:check": "node scripts/check-contract.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm contract:check"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.59.0",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@telegram-apps/telegram-ui": "^2.1.8",
    "date-fns": "^4.1.0",
    "eruda": "^3.4.3",
    "lucide-react": "^0.456.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.30.1",
    "zod": "^4.0.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@ngrok/ngrok": "^1.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "cloudflared": "^0.7.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vite-plugin-mkcert": "^1.17.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cloudflared",
      "@swc/core"
    ]
  }
}
