# Base URL of the Remy backend HTTP API (no trailing slash).
#
# Leave commented out in dev: the default "/api/v1" plus Vite's server.proxy
# forward everything to the local NestJS backend at localhost:3000. Same-origin
# means no CORS headaches and no need to tunnel the backend separately.
#
# Override in production with an absolute URL, e.g.:
#   VITE_API_BASE_URL=https://api.remy.example.com/api/v1
# VITE_API_BASE_URL=/api/v1

# `pnpm dev:ngrok` reads these from .env.local (gitignored). No VITE_ prefix,
# so they are never exposed to the browser bundle.
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# Optional: pin a domain you own in ngrok (free accounts get one dev domain).
# NGROK_DOMAIN=your-name.ngrok-free.dev

# Dev only. `pnpm dev:mock` sets this; the API is then mocked in-browser (MSW)
# and no backend is needed. Ignored in production builds.
# VITE_MOCK_API=1

# Telegram user id used by the mocked initData when running outside Telegram.
# Must equal OWNER_TELEGRAM_ID on the backend when using its dev bypass
# (DEV_ALLOW_MOCK_INITDATA=true). Default: 123456789
# VITE_MOCK_TG_USER_ID=123456789
